    classDef ops fill:#f4efff,stroke:#6b46a3,color:#35235a;
    classDef failure fill:#fff0f0,stroke:#b64b4b,color:#5a2020;
    class Producer,Review,CMS human;
    class State,Queue,Result store;
    class API,Orchestrator,Worker control;
    class Model,Evidence external;
    class Secrets,Telemetry,Alerts ops;
    class DLQ failure;
