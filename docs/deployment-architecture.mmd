flowchart TB
    Producer["Authenticated producer / reviewer"]
    API["Protected ingestion and review API<br/>TLS · WAF · rate limits · OIDC/OAuth"]

    subgraph Data["Encrypted data plane"]
        State["Transcript objects · job metadata · checkpoints"]
        Queue["Episode queue and backpressure"]
    end

    subgraph Compute["Private application network"]
        Orchestrator["Durable workflow orchestrator<br/>bounded retries · checkpoints"]
        Worker["Autoscaled ephemeral non-root worker<br/>normalize → plan → editorial → claims → evidence → validate"]
    end

    subgraph Approved["Approved services"]
        Model["Model gateway<br/>approved model endpoint"]
        Evidence["Evidence gateway<br/>allowlisted search / knowledge base"]
    end

    Result["Versioned JSON and Markdown results<br/>evidence metadata · validation · redacted trace"]
    Review["Mandatory human review"]
    CMS["CMS / export target"]
    DLQ["Dead-letter queue<br/>safe diagnostics · audited replay"]

    subgraph Operations["Governance and operations (cross-cutting)"]
        Secrets["Secrets manager + KMS"]
        Telemetry["Content-redacted logs, metrics, and traces"]
        Alerts["SLO, quality, and cost alerts"]
    end

    Producer --> API
    API --> State --> Queue
    Queue --> Orchestrator --> Worker
    Worker --> Model
    Worker --> Evidence
    Worker --> Result --> Review
    Review -->|"explicit approval only"| CMS
    Worker -. "terminal failure" .-> DLQ

